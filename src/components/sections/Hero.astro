---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import me from '../../assets/me.webp';
import { site } from '../../data/portfolio';

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-bright';
const button = 'inline-flex min-h-12 items-center justify-center gap-2.5 rounded-lg border px-4.5 py-3 text-sm font-bold transition duration-200 hover:-translate-y-0.5 motion-reduce:transform-none';
const typedPhrases = [
  'ideas en software.',
  'necesidades de negocio en sistemas.',
  'complejidad en claridad.',
];
---

<section
  class="mx-auto grid min-h-[calc(100svh-4.5rem)] w-[min(calc(100%-2rem),72rem)] items-center gap-16 py-[clamp(4.5rem,10vw,8rem)] md:w-[min(calc(100%-4rem),72rem)] lg:grid-cols-[minmax(0,1.25fr)_minmax(20rem,0.75fr)] lg:gap-12"
  id="inicio"
  aria-labelledby="hero-title"
>
  <div class="relative z-2 order-2 max-w-168 lg:order-1">
    <h1 id="hero-title" class="m-0 max-w-[11ch] text-[clamp(3.25rem,8vw,6.4rem)] leading-[0.95] font-medium tracking-[-0.065em]">
      Hola, soy<br /><span class="text-[#d9dbe0]">Jose Miguel Upia.</span>
    </h1>
    <p class="mt-8 max-w-156 text-[clamp(1rem,1.6vw,1.18rem)] text-muted">
      Desarrollador de software y arquitecto de soluciones web con experiencia en la creación de aplicaciones y sistemas escalables, eficientes y centrados en el usuario.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class:list={[button, focus, 'border-transparent bg-linear-to-br from-violet to-violet-bright shadow-[0_0.75rem_2rem_rgba(108,31,197,0.22)]']} href={site.cv} download>
        Descargar CV <Icon name="lucide:download" class="size-4" aria-hidden="true" />
      </a>
      <a class:list={[button, focus, 'border-paper/12 bg-surface/25 hover:border-paper/30 hover:bg-surface/50']} href="/about/">
        Acerca de mí <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 font-mono text-[0.72rem] text-[#8d979e]">
      <nav class="flex items-center gap-1" aria-label="Enlaces profesionales">
        <a class:list={['grid size-11 place-items-center rounded-lg text-muted transition hover:bg-surface/45 hover:text-paper', focus]} href={site.github} target="_blank" rel="noreferrer" aria-label="Visitar GitHub" title="GitHub">
          <Icon name="lucide:github" class="size-[1.1rem]" aria-hidden="true" />
        </a>
        <a class:list={['grid size-11 place-items-center rounded-lg text-muted transition hover:bg-surface/45 hover:text-paper', focus]} href={site.linkedin} target="_blank" rel="noreferrer" aria-label="Visitar LinkedIn" title="LinkedIn">
          <Icon name="lucide:linkedin" class="size-[1.1rem]" aria-hidden="true" />
        </a>
        <button class:list={['group/copy relative grid size-11 cursor-pointer place-items-center rounded-lg border-0 bg-transparent p-0 text-muted transition hover:bg-surface/45 hover:text-paper', focus]} type="button" data-copy-email data-email={site.email} aria-label="Copiar correo electrónico" title="Copiar correo electrónico">
          <Icon name="lucide:mail" class="size-[1.1rem]" aria-hidden="true" />
          <span class="pointer-events-none absolute bottom-[calc(100%+0.35rem)] left-1/2 -translate-x-1/2 rounded border border-paper/12 bg-panel px-2 py-1 text-[0.62rem] whitespace-nowrap text-paper opacity-0 shadow-lg transition-opacity group-data-[copied=true]/copy:opacity-100">Correo copiado</span>
        </button>
      </nav>
      <span class="hidden h-4 w-px bg-paper/12 sm:block" aria-hidden="true"></span>
      <p class="inline-flex items-center gap-2">
        <Icon name="lucide:map-pin" class="size-4 shrink-0 text-violet-bright" aria-hidden="true" />
        {site.location}
      </p>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
  </div>

  <div class="relative order-1 mt-4 w-[min(62vw,18rem)] justify-self-center lg:order-2 lg:mt-0 lg:w-[min(29vw,25.5rem)] lg:justify-self-end" aria-label={`Retrato de ${site.name}`}>
    <div class="absolute inset-[-8%] z-1 rounded-full border border-violet-bright/30" aria-hidden="true"></div>
    <div class="absolute inset-[-16%] z-1 rounded-full border border-violet/20" aria-hidden="true"></div>
    <div class="relative z-2 aspect-square overflow-hidden rounded-full border-[0.28rem] border-violet-bright bg-panel shadow-[0_0_0_0.8rem_rgba(108,31,197,0.08),0_0_5rem_rgba(108,31,197,0.28)]">
      <Image
        src={me}
        alt={`Retrato ilustrado de ${site.name}`}
        width={640}
        height={640}
        sizes="(max-width: 720px) 280px, 420px"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover"
      />
    </div>
    <p class="absolute -right-4 -bottom-5 z-3 m-0 flex min-h-11 items-center rounded-lg border border-paper/12 bg-panel px-3.5 py-2.5 font-mono text-[0.68rem] shadow-[0_1rem_2rem_rgba(0,0,0,0.25)] max-sm:right-1/2 max-sm:translate-x-1/2 max-sm:whitespace-nowrap">
      <span class="mr-2 text-paper/60" aria-hidden="true">&gt;_</span>
      <strong class="font-bold text-[#d26cff] drop-shadow-[0_0_0.7rem_rgba(182,53,242,0.45)]" aria-hidden="true">Convierto&nbsp;</strong>
      <span class="text-paper/85" data-typewriter data-phrases={JSON.stringify(typedPhrases)} aria-hidden="true">ideas en software.</span>
      <span class="ml-0.5 inline-block h-[1.05em] w-px animate-pulse bg-violet-bright motion-reduce:hidden" aria-hidden="true"></span>
      <span class="sr-only">Convierto ideas en software.</span>
    </p>
  </div>
</section>

<script src="../../scripts/hero-interactions.ts"></script>
