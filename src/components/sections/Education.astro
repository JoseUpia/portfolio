---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CertificateGallery from '../certificates/CertificateGallery.astro';
import { education, featuredCertificates } from '../../data/education';
import brandMark from '../../assets/brand/jmu-mark.svg';

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-bright';
const evidencePreviews = import.meta.glob('../../assets/certificates/previews/*.webp', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;
const getEvidencePreview = (name: string) => evidencePreviews[`../../assets/certificates/previews/${name}.webp`];
---

<section class="relative isolate mx-auto w-[min(calc(100%_-_2rem),72rem)] py-[clamp(5.5rem,11vw,9rem)] md:w-[min(calc(100%_-_4rem),72rem)]" id="formacion" aria-labelledby="education-title">
  <Image src={brandMark} alt="" class="pointer-events-none absolute -bottom-16 left-[calc((100vw_-_100%)/-2_+_1.5rem)] -z-10 w-[min(50vw,35rem)] opacity-[0.09] drop-shadow-[0_0_2.5rem_rgba(139,92,246,0.58)]" aria-hidden="true" />
  <SectionHeading
    headingId="education-title"
    index="04"
    label="Registro de aprendizaje"
    title="Formación y certificaciones"
    description="Formación académica y aprendizaje continuo aplicados a construir software con mejores fundamentos."
  />

  <div class="relative overflow-hidden rounded-2xl border border-paper/12 bg-linear-to-br from-violet-deep/20 via-panel/75 to-panel/45 px-5 py-8 sm:px-8 md:px-10 md:py-10">
    <div class="pointer-events-none absolute -top-28 -right-24 size-80 rounded-full bg-violet/12 blur-3xl" aria-hidden="true"></div>
    <div class="mb-9 flex items-end justify-between gap-6 border-b border-paper/10 pb-6">
      <div>
        <p class="font-mono text-[0.72rem] font-bold tracking-[0.1em] text-violet-bright uppercase">Trayectoria académica</p>
        <h3 class="mt-2 text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">Una base técnica que sigue creciendo.</h3>
      </div>
    </div>

    <ol class="relative grid list-none gap-0 p-0 before:absolute before:top-4 before:bottom-4 before:left-[0.9rem] before:w-[3px] before:bg-violet-bright before:shadow-[0_0_0.85rem_rgba(182,53,242,0.42)] lg:grid-cols-3 lg:gap-8 lg:before:top-[0.9rem] lg:before:right-4 lg:before:bottom-auto lg:before:left-4 lg:before:h-[3px] lg:before:w-auto">
      {education.map((entry) => {
        const evidencePreview = entry.evidence && getEvidencePreview(entry.evidence.preview);

        return (
          <li class="relative grid grid-cols-[2rem_minmax(0,1fr)] gap-5 pb-9 last:pb-0 lg:block lg:pb-0">
            <span class="relative z-1 grid size-8 place-items-center rounded-full border-2 border-violet-bright bg-ink text-violet-bright shadow-[0_0_0_0.35rem_rgba(182,53,242,0.12),0_0_1rem_rgba(182,53,242,0.32)] lg:mb-8" aria-hidden="true">
              <Icon name="lucide:graduation-cap" class="size-4" />
            </span>
            <article>
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <p class="font-mono text-[0.72rem] font-bold text-violet-bright">{entry.period}</p>
                {entry.status && <span class="rounded-full border border-success/30 bg-success/10 px-2 py-0.5 font-mono text-[0.65rem] font-bold text-success">{entry.status}</span>}
              </div>
              <h4 class="text-xl font-semibold tracking-[-0.025em]">{entry.degree}</h4>
              <p class="mt-2 text-sm font-semibold text-[#d8dde0]">{entry.institution}</p>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{entry.detail}</p>

              {entry.evidence && evidencePreview && (
                <a
                  class:list={['group/evidence mt-5 grid min-h-[9.25rem] grid-cols-[5rem_minmax(0,1fr)] overflow-hidden rounded-xl border border-paper/12 bg-ink/35 transition hover:border-violet-bright/40 hover:bg-ink/55', focus]}
                  href={`/certificates/pdf/${entry.evidence.certificateSlug}.pdf`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Abrir ${entry.evidence.title} en PDF`}
                >
                  <div class="grid min-h-24 place-items-center bg-[#e4e7e8] p-2">
                    <Image src={evidencePreview} alt="" widths={[160, 240, 320]} sizes="80px" loading="lazy" class="size-full object-contain" />
                  </div>
                  <div class="min-w-0 p-3">
                    <p class="font-mono text-[0.64rem] font-bold tracking-[0.08em] text-violet-bright uppercase">Documento verificable</p>
                    <h5 class="mt-1 text-sm font-bold text-paper group-hover/evidence:text-violet-bright">{entry.evidence.title}</h5>
                    <p class="mt-1 text-xs leading-relaxed text-muted">{entry.evidence.description}</p>
                  </div>
                </a>
              )}
            </article>
          </li>
        );
      })}
    </ol>
  </div>

  <div class="mt-16 mb-8 flex flex-col items-start justify-between gap-5 border-t border-paper/12 pt-8 sm:flex-row sm:items-end">
    <div>
      <p class="font-mono text-[0.72rem] font-bold tracking-[0.1em] text-violet-bright uppercase">Certificaciones destacadas</p>
      <h3 class="mt-2 text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">Cursos que amplían mi práctica.</h3>
    </div>
    <a class:list={['inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-paper/15 px-4 py-2 text-sm font-bold transition-colors hover:border-violet-bright/45 hover:bg-violet-deep/25', focus]} href="/certificates/">
      Ver todos los certificados
      <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
    </a>
  </div>

  <CertificateGallery certificates={featuredCertificates} presentation="featured" />
</section>
