---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ProjectCardProps } from '../../types/projects';

const { project, variant = 'default', index } = Astro.props as ProjectCardProps;
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-bright';
const isPublic = project.visibility === 'public';
const isSpotlight = variant === 'spotlight';
const isCompact = variant === 'compact';
const formattedDate = new Intl.DateTimeFormat('es-DO', { month: 'short', year: 'numeric' }).format(new Date(`${project.updatedAt}T12:00:00`));
---

<article class:list={[
  'group relative isolate flex h-full overflow-hidden rounded-2xl border border-paper/12 bg-[#1b2125]/95 shadow-[0_1.5rem_4rem_rgba(0,0,0,0.18)] transition duration-300 hover:-translate-y-1 hover:border-violet-bright/55 hover:shadow-[0_1.8rem_5rem_rgba(0,0,0,0.3),0_0_2.5rem_rgba(108,31,197,0.14)] motion-reduce:transform-none',
  'flex-col',
]}>
  <span class="pointer-events-none absolute inset-x-10 top-0 z-20 h-px bg-linear-to-r from-transparent via-violet-bright to-transparent opacity-70" aria-hidden="true"></span>

  <div class:list={[
    'relative overflow-hidden border-b border-paper/12 bg-[#211742]',
    isSpotlight ? 'aspect-[16/9] lg:aspect-[16/8.2]' : 'aspect-[16/9]',
    isCompact && 'lg:aspect-auto lg:h-40 lg:shrink-0',
  ]}>
    {project.image ? (
      <Image
        src={project.image}
        alt={`Vista de referencia de ${project.title}`}
        widths={[480, 720, 960, 1200]}
        sizes={isSpotlight ? '(max-width: 1024px) calc(100vw - 2rem), 44rem' : '(max-width: 768px) calc(100vw - 2rem), 18rem'}
        class="size-full object-cover object-top transition duration-700 group-hover:scale-[1.035] motion-reduce:transform-none"
      />
    ) : (
      <div class="flex size-full flex-col bg-[radial-gradient(circle_at_80%_35%,rgba(182,53,242,0.22),transparent_28%),linear-gradient(135deg,rgba(45,20,105,0.98),rgba(22,27,30,0.82)),repeating-linear-gradient(90deg,transparent_0_4rem,rgba(255,255,255,0.03)_4rem_calc(4rem+1px))]" aria-hidden="true">
        <div class="flex h-10 shrink-0 items-center gap-1.5 border-b border-paper/8 px-4">
          <i class="size-1.5 rounded-full bg-violet-bright"></i><i class="size-1.5 rounded-full bg-violet-bright/60"></i><i class="size-1.5 rounded-full bg-violet-bright/30"></i>
          <span class="ml-auto max-w-[70%] truncate font-mono text-[0.58rem] text-paper/45">{project.slug}</span>
        </div>
        <div class:list={['grid flex-1 items-center gap-4 p-6', isCompact ? 'grid-cols-[1.35fr_0.65fr] lg:p-4' : 'grid-cols-[1.25fr_0.75fr]']}>
          <div class="grid gap-2.5"><span class="h-2 w-1/3 rounded-full bg-violet-bright"></span><strong class="h-3.5 w-11/12 rounded-full bg-paper/75"></strong><strong class="h-2 w-3/4 rounded-full bg-paper/20"></strong><em class="h-2 w-1/2 rounded-full bg-paper/20"></em></div>
          <div class:list={['grid aspect-square place-items-center justify-self-center rounded-full border border-violet-bright/45 shadow-[0_0_0_0.6rem_rgba(108,31,197,0.1),0_0_2rem_rgba(182,53,242,0.2)]', isCompact ? 'w-14' : 'max-w-24']}><Icon name={isPublic ? 'lucide:code-2' : 'lucide:lock-keyhole'} class="size-7 text-violet-bright" /></div>
        </div>
      </div>
    )}
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-[#1b2125] to-transparent opacity-65" aria-hidden="true"></div>
    {index && <span class="absolute right-4 bottom-3 z-10 font-mono text-[0.65rem] font-bold tracking-[0.12em] text-paper/70">{index}</span>}
  </div>

  <div class:list={['relative flex min-w-0 flex-1 flex-col', isSpotlight ? 'p-6 md:p-7' : 'p-5', isCompact && 'lg:p-3.5']}>
    <div class:list={['flex items-center justify-between gap-3 font-mono tracking-[0.06em] uppercase', isCompact ? 'text-[0.6rem]' : 'text-[0.65rem]']}>
      <span class="truncate text-[#9aa4ab]">{project.eyebrow}</span>
      <span class:list={['inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1', isPublic ? 'border-success/25 bg-success/8 text-[#94d8b0]' : 'border-[#d4a24c]/25 bg-[#d4a24c]/8 text-[#e2c58f]']}>
        <i class:list={['size-1.5 rounded-full shadow-[0_0_0.55rem_currentColor]', isPublic ? 'bg-success' : 'bg-[#d4a24c]']}></i>{isPublic ? 'Público' : 'Privado'}
      </span>
    </div>
    <p class:list={['font-mono text-[0.65rem] tracking-[0.06em] text-violet-bright uppercase', isCompact ? 'mt-1.5' : 'mt-3']}>Actualizado {formattedDate}</p>
    <h3 class:list={['font-semibold tracking-[-0.035em] text-paper', isSpotlight ? 'mt-2 text-[clamp(1.65rem,3vw,2.35rem)]' : isCompact ? 'mt-1 text-lg' : 'mt-1.5 text-xl']}>{project.title}</h3>
    <p class:list={['leading-relaxed text-muted', isSpotlight ? 'mt-2.5 max-w-2xl text-base' : 'mt-2 text-sm', isCompact && 'lg:line-clamp-1']}>
      {project.description}
    </p>
    <ul class:list={['flex flex-wrap gap-2 p-0', isSpotlight ? 'mt-5' : isCompact ? 'mt-2.5' : 'mt-4']} aria-label={`Tecnologías de ${project.title}`}>
      {project.technologies.map((technology) => <li class:list={['list-none rounded-md border border-violet-bright/20 bg-violet-deep/14 px-2.5 py-1.5 font-mono text-[0.65rem] text-[#d3d8dc] transition group-hover:border-violet-bright/35', isCompact && 'lg:px-2 lg:py-1 lg:text-[0.6rem]']}>{technology}</li>)}
    </ul>
    <div class:list={['mt-auto flex flex-wrap gap-2.5', isSpotlight ? 'pt-6' : isCompact ? 'pt-2.5' : 'pt-4']}>
      {isPublic && project.repository && <a class:list={['inline-flex min-h-10 items-center gap-2 rounded-lg bg-violet-bright px-3.5 py-2 text-[0.75rem] font-bold text-ink transition hover:bg-[#ce70f8]', isCompact && 'lg:min-h-9 lg:px-3 lg:py-1.5', focus]} href={project.repository} target="_blank" rel="noreferrer"><Icon name="lucide:github" class="size-4" aria-hidden="true" /> Repositorio <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" /></a>}
      {project.website && <a class:list={['inline-flex min-h-10 items-center gap-2 rounded-lg border border-paper/14 bg-surface/35 px-3.5 py-2 text-[0.75rem] font-bold text-paper transition hover:border-paper/30 hover:bg-surface/60', isCompact && 'lg:min-h-9 lg:px-3 lg:py-1.5', focus]} href={project.website} target="_blank" rel="noreferrer"><Icon name="lucide:globe-2" class="size-4 text-violet-bright" aria-hidden="true" /> Visitar web <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" /></a>}
      {!isPublic && !project.website && <span class:list={['inline-flex min-h-10 items-center gap-2 rounded-lg border border-paper/10 bg-surface/20 px-3 font-mono text-[0.65rem] text-paper/50', isCompact && 'lg:min-h-9']}><Icon name="lucide:shield-check" class="size-4 text-[#d4a24c]" aria-hidden="true" /> Código privado</span>}
    </div>
  </div>
</article>
