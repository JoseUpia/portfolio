---
import { Image } from 'astro:assets';

import '../styles/global.css'
import me from '../assets/me.webp'
import logo from '../assets/jmu-logo.svg'

const title = 'Jose Miguel Upia'

const disciplines = [
  'Frontend',
  'Full-stack',
  'Creative code',
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#12072d" />
    <meta name="description" content="Portfolio of Jose Miguel Upia, full-stack software developer specializing in frontend. Coming soon." />
	
    <title>{title} — Portfolio in development</title>
  </head>

  <body class="m-0 bg-purple-50 text-purple-950 antialiased">
    <main class="min-h-screen overflow-hidden">
      <div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-6 py-6 sm:px-10 lg:px-16">
        <header class="flex items-center justify-between">
          <a href="#home" class="flex items-center gap-3" aria-label="Jose Miguel Upia">
            <Image src={logo} alt="Jose Miguel Upia personal logo" width={58} height={34} class="h-9 w-auto object-contain"/>
            <span class="hidden text-sm font-semibold tracking-tight text-purple-950 sm:inline"></span>
          </a>

          <span class="rounded-full border border-purple-600/20 bg-purple-600/10 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-purple-700 sm:text-[11px] sm:tracking-[0.18em]">
            Portfolio 2026
          </span>
        </header>

        <section id="home" class="flex flex-1 items-center py-12 sm:py-16 lg:py-12">
          <div class="grid w-full items-center gap-12 md:gap-14 lg:grid-cols-[1fr_0.8fr] lg:gap-20">
            <div class="order-2 max-w-xl lg:order-1">
              <p class="mb-6 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-purple-600 sm:tracking-[0.2em]">
                <span class="h-px w-8 bg-purple-600" aria-hidden="true"></span>
                Website under construction
              </p>

              <h1 class="max-w-lg text-balance text-5xl font-semibold leading-[1.02] tracking-[-0.06em] text-purple-950 sm:text-7xl">
                Hi, I'm <span class="text-purple-600">Jose Miguel Upia</span>
              </h1>

              <p class="mt-7 max-w-md text-pretty text-base leading-7 text-purple-950/60 sm:text-lg">
                Full-stack software developer focused on building
                clear, fast, and purposeful frontend experiences.
              </p>

              <div class="mt-9 flex items-center gap-3">
                <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-600 opacity-60"/>
                  <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-purple-600"/>
                </span>

                <p class="text-sm text-purple-950/60">
                  I'm preparing something new.
                </p>
              </div>

              <div class="mt-10 border-t border-purple-200 pt-5">
                <p class="text-sm leading-6 text-purple-950/60">
                  Soon you'll be able to explore my projects,
                  skills, and the way I turn ideas into digital
                  products.
                </p>
              </div>
            </div>

            <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
              <div class="relative w-full max-w-75 sm:max-w-90 lg:max-w-97.5">
                <div class="absolute -inset-3 rounded-full border border-purple-600/20 sm:-inset-5" aria-hidden="true">
                </div>

                <div class="relative aspect-square overflow-hidden rounded-full bg-purple-100 shadow-2xl shadow-purple-600/20">
					<Image src={me} alt="Retrato ilustrado de Jose Miguel Upia" width={390}
						height={390} sizes="(max-width: 640px) 300px, (max-width: 1024px) 360px, 390px"
						class="aspect-square w-full object-cover"
					/>
                </div>

                <div class="absolute -bottom-5 -left-4 rounded-xl border border-purple-200 bg-white px-4 py-3 shadow-lg sm:-left-8">
                  <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-purple-950/50">
                    Coming soon
                  </p>

                  <p class="mt-1 text-sm font-medium text-purple-950">
                    Building with code
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <footer class="flex flex-col gap-2 border-t border-purple-200 py-5 text-xs text-purple-950/50 sm:flex-row sm:items-center sm:justify-between">
          <span>
            © 2026 {title}
          </span>

          <span class="font-mono">
            {disciplines.join(' · ').toLowerCase()}
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>