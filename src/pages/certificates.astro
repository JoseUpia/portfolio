---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { certificates } from '../data/education';
import CertificateGallery from '../components/certificates/CertificateGallery.astro';

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-bright';
---

<BaseLayout
  title="Certificaciones — Jose Miguel Upia"
  description="Certificaciones y formación complementaria de Jose Miguel Upia en desarrollo de software, redes y herramientas digitales."
>
  <Header />
  <main id="contenido" class="mx-auto w-[min(calc(100%_-_2rem),72rem)] py-[clamp(4.5rem,9vw,8rem)] md:w-[min(calc(100%_-_4rem),72rem)]">
    <a class:list={['inline-flex min-h-11 items-center gap-2 text-sm font-bold text-muted transition-colors hover:text-paper', focus]} href="/#formacion">
      <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
      Volver a formación
    </a>

    <header class="mt-9 mb-12 grid gap-6 border-b border-paper/12 pb-10 md:grid-cols-[minmax(0,1fr)_minmax(16rem,0.45fr)] md:items-end">
      <div>
        <p class="font-mono text-[0.72rem] font-bold tracking-[0.1em] text-violet-bright uppercase">// Archivo de aprendizaje</p>
        <h1 class="mt-3 text-[clamp(3rem,8vw,6.5rem)] leading-[0.92] font-medium tracking-[-0.065em]">Certificados</h1>
      </div>
      <p class="max-w-lg text-muted">Cursos, programas y reconocimientos que complementan mi formación académica y documentan un proceso de aprendizaje continuo.</p>
    </header>

    <div class="mb-8 flex items-center justify-between gap-4">
      <p class="font-mono text-xs font-bold text-muted"><span class="text-violet-bright">{certificates.length}</span> credenciales verificables</p>
      <p class="hidden text-sm text-muted sm:block">Abre una vista previa o el PDF original.</p>
    </div>

    <CertificateGallery certificates={certificates} presentation="catalog" />
  </main>
  <Footer />
</BaseLayout>
